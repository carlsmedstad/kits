#!/bin/bash

set -euo pipefail

argv0=arch-rdepends

cache_home=${XDG_CACHE_HOME:-$HOME/.cache}
nvcheck_default=$cache_home/arch-nvcheck/check-$USER.json

usage() {
  cat << EOF >&2
Usage: $argv0 [options...] pkgname...

Lists the packages that depend on the given packages, including make
and check dependencies, the way the package details page on
https://archlinux.org/ does. Packages depending on something the given
packages provide are listed too.

The dependencies are read from the pacman sync databases, so only the
repositories pacman is configured to use are searched - enable
multilib in pacman.conf to cover it, and run pacman -Sy to refresh.

Output is deduplicated on the printed columns, so --columns pkgbase
prints every pkgbase to rebuild exactly once. Columns are aligned on a
terminal and tab-separated when piped, so pipe through cat to see the
tabs.

Columns:
  pkgname       Name of the package that depends on the target
  pkgbase       Its pkgbase
  repository    Repository holding it
  target        The given package it depends on
  type          Dependency types it uses, comma-separated; describes a
                package, so pkgname or pkgbase has to be printed too
  version       Its version in the arch-nvcheck result file
  upstream      The upstream version arch-nvcheck found

The version columns and --out-of-date join on pkgbase and print - for
packages missing from the result file.

Options:
  -c, --columns <cols>    Comma-separated columns to print
                          default: pkgname,repository,type
  -t, --deptype <types>   Comma-separated dependency types to list:
                          depend, optdepend, makedepend, checkdepend
                          default: all
  -r, --repo <repos>      Comma-separated repositories to list packages
                          from; every database is still searched
                          default: all synced databases
  -o, --out-of-date       Only list packages arch-nvcheck flags as
                          out of date
      --nvcheck <file>    arch-nvcheck result file
                          default: $nvcheck_default
      --dbpath <path>     Pacman database path
                          default: pacman-conf DBPath
      --header            Print header
  -h, --help              Display this help message and exit

Examples:
  $argv0 cmocka
  $argv0 --columns pkgbase fmt | xargs arch-rebuild-order
  $argv0 --deptype makedepend,checkdepend --columns pkgbase,type cmake
  $argv0 --out-of-date --columns pkgbase,version,upstream fmt
EOF
}

columns=pkgname,repository,type
header=0
out_of_date=0
nvcheck=$nvcheck_default
deptypes=
repos=
dbpath=

opt_short='c:t:r:oh'
opt_long='columns:,deptype:,repo:,out-of-date,nvcheck:,dbpath:,header,help'
if opts=$(getopt -o "$opt_short" -l "$opt_long" -n "$argv0" -- "$@"); then
  eval set -- "$opts"
fi

while true; do
  case $1 in
  -c | --columns)
    shift
    columns=${1:-}
    ;;
  -t | --deptype)
    shift
    deptypes=${1:-}
    ;;
  -r | --repo)
    shift
    repos=${1:-}
    ;;
  -o | --out-of-date)
    out_of_date=1
    ;;
  --nvcheck)
    shift
    nvcheck=${1:-}
    ;;
  --dbpath)
    shift
    dbpath=${1:-}
    ;;
  --header)
    header=1
    ;;
  -h | --help)
    usage
    exit
    ;;
  --)
    shift
    break
    ;;
  *)
    exit 1
    ;;
  esac
  shift
done

if [ "$#" -eq 0 ]; then
  printf >&2 '%s: no package supplied\n' "$argv0"
  exit 1
fi

if [ -z "$columns" ]; then
  printf >&2 '%s: no column supplied\n' "$argv0"
  exit 1
fi

keycols=
header_line=
typepos=0
position=0
nkeys=0
need_nvcheck=$out_of_date
declare -A seen=()
IFS=, read -ra requested <<< "$columns"
for column in "${requested[@]}"; do
  case $column in
  version | upstream) need_nvcheck=1 ;;
  pkgname | pkgbase | repository | target | type) ;;
  *)
    printf >&2 '%s: %s: invalid column\n' "$argv0" "$column"
    exit 1
    ;;
  esac
  if [ -n "${seen[$column]:-}" ]; then
    printf >&2 '%s: %s: duplicate column\n' "$argv0" "$column"
    exit 1
  fi
  seen[$column]=1
  position=$((position + 1))
  header_line+=${header_line:+$'\t'}$column
  if [ "$column" = type ]; then
    typepos=$position
  else
    nkeys=$((nkeys + 1))
    keycols+=${keycols:+,}$column
  fi
done

if [ "$typepos" -ne 0 ] && [ -z "${seen[pkgname]:-}${seen[pkgbase]:-}" ]; then
  printf >&2 '%s: type needs pkgname or pkgbase beside it\n' "$argv0"
  exit 1
fi

if [ "$need_nvcheck" = 1 ] && [ ! -f "$nvcheck" ]; then
  printf >&2 '%s: %s: does not exist, run arch-nvcheck first\n' "$argv0" "$nvcheck"
  exit 1
fi

letters=DOMC
if [ -n "$deptypes" ]; then
  letters=
  IFS=, read -ra requested <<< "$deptypes"
  for deptype in "${requested[@]}"; do
    case $deptype in
    depend) letters+=D ;;
    optdepend) letters+=O ;;
    makedepend) letters+=M ;;
    checkdepend) letters+=C ;;
    *)
      printf >&2 '%s: %s: invalid dependency type\n' "$argv0" "$deptype"
      exit 1
      ;;
    esac
  done
fi

[ -n "$dbpath" ] || dbpath=$(pacman-conf DBPath)
syncdir=${dbpath%/}/sync

repofilter=
if [ -n "$repos" ]; then
  IFS=, read -ra requested <<< "$repos"
  for repo in "${requested[@]}"; do
    if [ ! -f "$syncdir/$repo.db" ]; then
      printf >&2 '%s: %s: no database in %s, run pacman -Sy\n' \
        "$argv0" "$repo" "$syncdir"
      exit 1
    fi
    repofilter+=${repofilter:+ }$repo
  done
fi

# Every database is read whatever --repo says: a target's provides may be
# recorded in a repository the filter excludes.
shopt -s nullglob
dbs=("$syncdir"/*.db)
shopt -u nullglob
if [ "${#dbs[@]}" -eq 0 ]; then
  printf >&2 '%s: no databases in %s, run pacman -Sy\n' "$argv0" "$syncdir"
  exit 1
fi

format() {
  if [ -t 1 ]; then
    column --table --separator "$(printf '\t')"
  else
    cat
  fi
}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

: > "$tmp/nvcheck"
if [ "$need_nvcheck" = 1 ]; then
  jq -r '
    .[] | [.pkgbase, (.local_version // "-"), (.upstream_version // "-"),
      (if .out_of_date then "yes" else "no" end)] | @tsv
  ' "$nvcheck" > "$tmp/nvcheck"
fi

for db in "${dbs[@]}"; do
  repo=$(basename "$db" .db)
  printf '%%REPO%%\n%s\n\n' "$repo"
  # A repository database holds nothing but desc members, and asking
  # bsdtar for them by name makes it fail on an empty repository.
  bsdtar -xOf "$db"
done > "$tmp/desc"

awk -v targets="$*" -v letters="$letters" -v keycols="$keycols" \
  -v withtype="$typepos" -v onlyoutdated="$out_of_date" -v repofilter="$repofilter" '
  function bare(dep) {
    sub(/[<>=:].*/, "", dep)
    return dep
  }
  function value(column, target) {
    if (column == "pkgname") return pkgname
    if (column == "pkgbase") return pkgbase
    if (column == "repository") return repo
    if (column == "version") return (pkgbase in localver) ? localver[pkgbase] : "-"
    if (column == "upstream") return (pkgbase in upstream) ? upstream[pkgbase] : "-"
    return target
  }
  BEGIN {
    nkeys = split(keycols, key, ",")
    split(targets, list, " ")
    for (i in list) want[list[i]] = list[i]
    nrepos = split(repofilter, list, " ")
    for (i in list) keeprepo[list[i]] = 1
    rank["%DEPENDS%"] = 0; letter["%DEPENDS%"] = "D"
    rank["%OPTDEPENDS%"] = 1; letter["%OPTDEPENDS%"] = "O"
    rank["%MAKEDEPENDS%"] = 2; letter["%MAKEDEPENDS%"] = "M"
    rank["%CHECKDEPENDS%"] = 3; letter["%CHECKDEPENDS%"] = "C"
  }
  ARGIND == 1 {
    split($0, entry, "\t")
    localver[entry[1]] = entry[2]
    upstream[entry[1]] = entry[3]
    if (entry[4] == "yes") outdated[entry[1]] = 1
    next
  }
  ARGIND == 3 && FNR == 1 {
    for (name in provides)
      want[name] = (name in want ? want[name] " " : "") provides[name]
  }
  /^%[A-Z0-9]+%$/ { section = $0; next }
  NF == 0 { next }
  section == "%REPO%" { repo = $0; next }
  section == "%NAME%" { pkgname = $0; pkgbase = $0; istarget = $0 in want; next }
  section == "%BASE%" { pkgbase = $0; next }
  ARGIND == 2 {
    if (istarget && section == "%PROVIDES%") {
      provided = bare($0)
      provides[provided] = (provided in provides ? provides[provided] " " : "") pkgname
    }
    next
  }
  !(section in rank) { next }
  !index(letters, letter[section]) { next }
  nrepos && !(repo in keeprepo) { next }
  onlyoutdated && !(pkgbase in outdated) { next }
  bare($0) in want {
    nhits = split(want[bare($0)], hits, " ")
    for (h = 1; h <= nhits; h++) {
      out = ""
      for (i = 1; i <= nkeys; i++)
        out = (i == 1) ? value(key[i], hits[h]) : out "\t" value(key[i], hits[h])
      if (withtype) out = (nkeys ? out "\t" : "") rank[section]
      print out
    }
  }
' "$tmp/nvcheck" "$tmp/desc" "$tmp/desc" | LC_ALL=C sort -u > "$tmp/matches"
# The type join groups adjacent rows, so the sort must be by byte: the tab
# separating a key from its rank has to collate below every byte a key holds.

{
  if [ "$header" = 1 ]; then
    printf '%s\n' "$header_line"
  fi
  if [ "$typepos" -eq 0 ]; then
    cat "$tmp/matches"
  else
    awk -F '\t' -v typepos="$typepos" -v nkeys="$nkeys" '
      function emit(   i, taken, value, out) {
        taken = 0
        for (i = 1; i <= nkeys + 1; i++) {
          value = (i == typepos) ? deptypes : field[++taken]
          out = (i == 1) ? value : out "\t" value
        }
        print out
      }
      BEGIN { split("depend optdepend makedepend checkdepend", label, " ") }
      {
        line = ""
        for (i = 1; i < NF; i++) line = (i == 1) ? $i : line "\t" $i
        if (!started || line != key) {
          if (started) emit()
          key = line
          for (i = 1; i < NF; i++) field[i] = $i
          deptypes = ""
          started = 1
        }
        deptypes = deptypes (deptypes ? "," : "") label[$NF + 1]
      }
      END { if (started) emit() }
    ' "$tmp/matches"
  fi
} | format

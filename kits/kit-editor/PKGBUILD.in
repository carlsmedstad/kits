pkgname=kit-editor
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Kit installing the editor Neovim"
arch=('any')
url="https://github.com/carlsmedstad/kits"
license=('MIT')
depends=(
  neovim
  gcc             # required for compiling tree-sitter grammars
  tree-sitter-cli # required for compiling tree-sitter grammars
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd $pkgname-$pkgver
  install -vDm755 -t "$pkgdir/usr/bin" files/nvim-lazy-update
  install -vDm755 -t "$pkgdir/usr/bin" files/nvim-mkspell

  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}

pkgname=kit-base-system
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Kit for base system"
arch=('any')
url="https://github.com/carlsmedstad/kits"
license=('MIT')
depends=(
  amd-ucode
  base
  intel-ucode
  iwd
  linux
  linux-firmware
  lvm2
  nftables
  pacman-contrib
  sudo
  tlp
  zram-generator
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')
install=$pkgname.install

package() {
  cd $pkgname-$pkgver
  install -vDm755 -t "$pkgdir/usr/bin" files/arch-clean

  install -vDm644 -t "$pkgdir/boot/loader" files/loader.conf
  # mkinitcpio writes the unified kernel images here and does not create it.
  install -vd "$pkgdir/boot/EFI/Linux"

  install -vDm644 files/cmdline.conf \
    "$pkgdir/etc/cmdline.d/10-kit-base-system.conf"
  install -vDm644 -t "$pkgdir/etc/mkinitcpio.conf.d" files/10-sd-encrypt.conf
  install -vDm644 -t "$pkgdir/etc/mkinitcpio.d" files/linux.preset
  install -vDm644 files/mkinitcpio.hook \
    "$pkgdir/usr/share/libalpm/hooks/95-kit-base-system-mkinitcpio.hook"
  install -vDm644 -t "$pkgdir/etc/systemd/network" files/20-wired.network
  install -vDm644 -t "$pkgdir/etc/systemd/network" files/25-wireless.network
  install -vDm644 -t "$pkgdir/etc/udev/rules.d" files/99-usb-root-hub-wakeup.rules
  install -vDm440 files/sudoers-wheel "$pkgdir/etc/sudoers.d/kit-wheel"
  install -vDm644 -t "$pkgdir/etc/sysctl.d" files/99-hardening.conf
  install -vDm644 -t "$pkgdir/etc/sysctl.d" files/99-zram.conf
  install -vDm644 -t "$pkgdir/etc/tlp.d" files/15-cpu-perf-on-ac.conf
  install -vDm644 files/resolved.conf \
    "$pkgdir/etc/systemd/resolved.conf.d/10-kit-base-system.conf"
  install -vDm644 -t "$pkgdir/etc/systemd" files/zram-generator.conf
  install -vDm644 files/modules-load-zram.conf \
    "$pkgdir/etc/modules-load.d/zram.conf"
  install -vDm644 files/oomd-root-slice.conf \
    "$pkgdir/etc/systemd/system/-.slice.d/99-oomd.conf"
  install -vDm644 files/oomd-user-service.conf \
    "$pkgdir/etc/systemd/system/user@.service.d/99-oomd.conf"
  install -vDm644 files/kit-base-system.preset \
    "$pkgdir/usr/lib/systemd/system-preset/50-kit-base-system.preset"
  install -vDm644 -t "$pkgdir/usr/lib/$pkgname" files/crypttab.initramfs.in
  install -vDm644 -t "$pkgdir/usr/lib/$pkgname" files/fstab.in
  install -vDm755 -t "$pkgdir/usr/lib/$pkgname" files/render-crypttab-initramfs
  install -vDm755 -t "$pkgdir/usr/lib/$pkgname" files/render-fstab

  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE
}
